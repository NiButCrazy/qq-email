{
  "name": "qq-email",
  "version": "0.2.3",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preinstall": "npx only-allow pnpm",
    "tauri": "tauri",
    "tauri:dev": "cross-env VITE_REACT_DEVTOOLS=1 tauri dev",
    "tauri:ext": "cross-env TAURI_ENV_EXTENSION=1 tauri dev",
    "tauri:web": "cross-env TAURI_ENV_WEB_INVOKE=1 tauri dev",
    "doc:tauri": "cd src-tauri && cargo doc --open --no-deps",
    "version": "pnpm version:sync && git add src-tauri/Cargo.toml src-tauri/Cargo.lock && pnpm changelog",
    "version:sync": "node ./scripts/version.ts && cd src-tauri && cargo check --offline",
    "changelog": "git cliff && git add CHANGELOG.md"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "cross-env": "^10.1.0"
  },
  "dependencies": {
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-deep-link": "~2.4.9",
    "@tauri-apps/plugin-log": "~2.8.0",
    "@tauri-apps/plugin-store": "~2.4.5",
    "@tauri-apps/plugin-window-state": "~2"
  }
}
